{
  "name": "lecture-notes",
  "private": true,
  "type": "module",
  "description": "Oxford lecture notes as an interactive site: build, and run locally with Ask Claude through the Claude Agent SDK",
  "scripts": {
    "build": "python3 build/build.py",
    "start": "python3 build/build.py && node local/server.mjs",
    "serve": "node local/server.mjs",
    "login": "node local/claude.mjs auth login",
    "status": "node local/claude.mjs auth status"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331"
  }
}
